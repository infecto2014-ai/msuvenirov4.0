---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ConceptHeader from '@/components/home-concept/ConceptHeader.astro';
import MerchHero from '@/components/home-concept/MerchHero.astro';
import PrintSeries from '@/components/home-concept/PrintSeries.astro';
import MerchWorks from '@/components/home-concept/MerchWorks.astro';
import MerchReviews from '@/components/home-concept/MerchReviews.astro';
import MerchWhy from '@/components/home-concept/MerchWhy.astro';
import MerchOrder from '@/components/home-concept/MerchOrder.astro';
import MerchFaq from '@/components/home-concept/MerchFaq.astro';
import MerchLocation from '@/components/home-concept/MerchLocation.astro';
import MerchFooter from '@/components/home-concept/MerchFooter.astro';
import { merchFaq } from '@/data/merch-faq';
import { faqPage } from '@/lib/schema';
import '@/styles/merch-home.css';
---

<BaseLayout
  title="Печать на одежде и сувенирах в Калининграде — Мастерская сувениров"
  description="Печать на футболках, кружках и шопперах в Калининграде. В ТЦ «Экватор» печатаем подарки по одному и мерч для компаний. Узнайте, как подготовить макет и забрать заказ."
  path="/"
  schema={[faqPage(merchFaq)]}
  homeConcept
>
  <ConceptHeader slot="header" />
  <MerchHero />
  <PrintSeries />
  <MerchWorks />
  <MerchReviews />
  <MerchWhy />
  <MerchOrder />
  <MerchFaq />
  <MerchLocation />
  <MerchFooter slot="footer" />
</BaseLayout>
