---
import { Image } from 'astro:assets';
import { printShowcase } from '@/data/print-showcase';
---

<section class="series" id="print-series" aria-labelledby="print-series-title">
  <div class="series-intro">
    <h2 id="print-series-title">На чём печатаем</h2>
    <p>Потяните в сторону и выберите изделие.</p>
  </div>

  <ul class="showcase" role="list" data-showcase>
    {printShowcase.map(({ name, text, href, image, size, position }) => (
      <li class:list={['piece', `piece--${size}`, `piece--${position}`]}>
        <a class="piece-link" href={href} data-description={text} draggable="false">
          <span class="piece-label">{name}</span>
          <Image
            src={image}
            alt=""
            format="webp"
            widths={[400, 640, 900, 1200].filter((width) => width <= image.width)}
            sizes={`(max-width: 720px) 80vw, ${size === 'large' ? '43vw' : size === 'medium' ? '34vw' : '23vw'}`}
            width={Math.min(image.width, 1200)}
            loading="lazy"
            draggable="false"
          />
        </a>
      </li>
    ))}
  </ul>

  <dialog class="product-dialog" aria-labelledby="showcase-product-title" data-product-dialog>
    <div class="product-card">
      <form method="dialog">
        <button class="product-close" aria-label="Закрыть" autofocus>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"/>
          </svg>
        </button>
      </form>
      <img class="product-image" alt="" width="400" height="400" />
      <div class="product-info">
        <h3 id="showcase-product-title"></h3>
        <p></p>
        <div class="product-actions">
          <button type="button" data-order="" data-order-product>Сделать заказ</button>
          <a href="/pechat-na-futbolkah">Подробнее <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  import '@/scripts/print-showcase';
</script>

<style>
  .series {
    --edge: clamp(1.125rem, 4.2cqi, 4.75rem);
    max-width: 105rem;
    margin-inline: auto;
    color: var(--merch-ink);
    container-type: inline-size;
  }

  .series-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .5rem 2rem;
    padding: clamp(1.5rem, 3.5cqi, 3.5rem) var(--edge) .75rem;
  }

  .series-intro h2 {
    font-size: clamp(2.25rem, 5.8cqi, 5.1rem);
    font-weight: 740;
    line-height: 1.04;
    letter-spacing: -.05em;
  }

  .series-intro p {
    color: var(--merch-muted);
    font-size: clamp(.875rem, 1.35cqi, 1.075rem);
  }

  .showcase {
    display: flex;
    align-items: stretch;
    gap: .5rem;
    margin: 0;
    padding: 1rem var(--edge) 2rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: var(--edge);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .showcase::-webkit-scrollbar {
    display: none;
  }

  .piece {
    flex: 0 0 80%;
    display: grid;
    align-items: center;
    min-width: 0;
    min-height: clamp(16rem, 63cqi, 22rem);
    scroll-snap-align: start;
  }

  .piece--small {
    flex-basis: 62%;
  }

  .piece-link {
    position: relative;
    display: grid;
    justify-items: start;
    gap: .6rem;
    padding: .4rem;
    color: inherit;
    text-decoration: none;
    border-radius: 1rem;
  }

  .piece-link img {
    display: block;
    width: 100%;
    height: clamp(12rem, 56cqi, 19rem);
    object-fit: contain;
    filter: drop-shadow(0 .55rem .5rem rgb(16 16 16 / .14));
    transform: rotate(var(--tilt, -4deg));
    transition: transform 220ms var(--ease-out);
  }

  .piece--small img {
    height: clamp(10rem, 44cqi, 16rem);
  }

  .piece:nth-child(even) {
    --tilt: 5deg;
  }

  .piece-label {
    position: relative;
    margin-inline-start: .3rem;
    min-height: 1.4rem;
    font-size: clamp(.9375rem, 1.45cqi, 1.375rem);
    font-weight: 650;
    line-height: 1.2;
    text-wrap: balance;
  }

  .piece-label::after {
    content: '';
    display: block;
    width: 2rem;
    height: .55rem;
    margin-top: .2em;
    border-top: 2px solid var(--merch-lime);
    border-radius: 50%;
    transform: rotate(-8deg);
  }

  @media (min-width: 45rem) {
    .showcase {
      gap: clamp(.6rem, 1.2cqi, 1.25rem);
      height: clamp(26rem, 40cqi, 43rem);
      scroll-snap-type: none;
    }

    .piece--large { flex-basis: 43%; }
    .piece--medium { flex-basis: 34%; }
    .piece--small { flex-basis: 23%; }
    .piece--high { align-items: start; }
    .piece--low { align-items: end; }

    .piece-link {
      padding: .65rem;
    }

    .piece img {
      height: clamp(13rem, 33cqi, 36rem);
    }

    .piece--small img {
      height: clamp(9rem, 17cqi, 19rem);
    }

    .piece--medium img {
      height: clamp(13rem, 28cqi, 30rem);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .showcase,
    .piece-link {
      cursor: grab;
    }

    .showcase[data-dragging],
    .showcase[data-dragging] .piece-link {
      cursor: grabbing;
      scroll-snap-type: none;
    }

    .piece-label {
      opacity: 0;
      transform: translateY(.35rem);
      transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
    }

    .showcase:not([data-dragging]) .piece-link:hover .piece-label,
    .piece-link:focus-visible .piece-label {
      opacity: 1;
      transform: none;
    }

    .showcase:not([data-dragging]) .piece-link:hover img {
      transform: translateY(-.25rem) rotate(var(--tilt, -4deg));
    }
  }

  :global(html:has(.product-dialog[open])) {
    overflow: hidden;
  }

  .product-dialog {
    position: fixed;
    width: min(43rem, calc(100vw - 2rem));
    max-height: 92dvh;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 1.5rem;
    background: #fff;
    color: var(--merch-ink);
    box-shadow: 0 1rem 4rem rgb(0 0 0 / .2);
    transition: opacity 180ms var(--ease-out), transform 220ms var(--ease-out);
  }

  .product-dialog::backdrop {
    background: rgb(16 16 16 / .48);
  }

  .product-dialog:not([open]) {
    opacity: 0;
    transform: translateY(.6rem);
    pointer-events: none;
  }

  @supports (overlay: auto) {
    .product-dialog {
      transition-property: opacity, transform, display, overlay;
      transition-behavior: allow-discrete;
    }
  }

  @starting-style {
    .product-dialog[open] {
      opacity: 0;
      transform: translateY(.6rem);
    }
  }

  .product-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 1.5rem;
    padding: 2.25rem 1.5rem 1.5rem;
  }

  .product-card > form {
    position: absolute;
    z-index: 1;
    top: .65rem;
    right: .65rem;
  }

  .product-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--sky);
  }

  .product-close:hover {
    background: var(--merch-lime);
  }

  .product-image {
    width: 100%;
    height: clamp(11rem, 28vw, 18rem);
    object-fit: contain;
    filter: drop-shadow(0 .55rem .5rem rgb(16 16 16 / .14));
  }

  .product-info h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .product-info p {
    margin: .65rem 0 1.1rem;
    color: var(--merch-muted);
    line-height: 1.45;
  }

  .product-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .product-actions :is(a, button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    min-height: 46px;
    padding: .5rem .85rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: #fff;
    color: inherit;
    font-size: .9375rem;
    font-weight: 650;
    text-decoration: none;
  }

  .product-actions button {
    border-color: var(--merch-lime);
    background: var(--merch-lime);
  }

  .product-actions :is(a, button):hover {
    border-color: var(--merch-ink);
  }

  @media (max-width: 35rem) {
    .product-dialog {
      width: 100%;
      max-width: none;
      margin: auto 0 0;
      border-radius: 1.5rem 1.5rem 0 0;
    }

    .product-card {
      grid-template-columns: 1fr;
      gap: .65rem;
      padding: .875rem 1.125rem calc(1.25rem + env(safe-area-inset-bottom));
    }

    .product-image { height: min(12rem, 33dvh); }

    .product-actions > * { flex: 1 1 auto; }

    .product-dialog:not([open]) { transform: translateY(1.25rem); }

    @starting-style {
      .product-dialog[open] { transform: translateY(1.25rem); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-dialog,
    .piece-link img,
    .piece-label {
      transition: none;
    }
  }
</style>
