---
import { Image } from 'astro:assets';
import { printShowcase } from '@/data/print-showcase';

const marks = [
  { x: 39, y: 5, size: 2.4, ring: true },
  { x: 52, y: 34, size: 3.8, ring: true },
  { x: 58, y: 44, size: 1.5, accent: true },
  { x: 83, y: 7, size: 1.9 },
  { x: 90, y: 46, size: 2.2, ring: true },
  { x: 122, y: 5, size: 2.6, ring: true },
  { x: 145, y: 22, size: 2 },
  { x: 176, y: 24, size: 1.5, accent: true },
  { x: 194, y: 12, size: 3.3, ring: true },
  { x: 219, y: 46, size: 2.2 },
];
---

<section class="series" id="print-series" aria-labelledby="print-series-title">
  <div class="series-intro">
    <h2 id="print-series-title">На чём печатаем</h2>
    <p>Потяните в сторону и выберите изделие.</p>
  </div>

  <div class="showcase" data-showcase>
    <ul
      class="showcase-canvas"
      role="list"
      style={`--canvas-width: ${Math.max(...printShowcase.map(({ layout: [x, , width] }) => x + width)) + 2}`}
    >
      {marks.map((mark) => (
        <li
          class:list={['print-mark', { 'print-mark--ring': mark.ring, 'print-mark--accent': mark.accent }]}
          style={`--x:${mark.x};--y:${mark.y};--mark-size:${mark.size}`}
          aria-hidden="true"
          data-print-mark
        >
          <span></span>
        </li>
      ))}
      {printShowcase.map(({ name, text, href, image, layout: [x, y, width, height, tilt], caption: [labelX, labelY] }) => {
        const imageWidth = Math.min(width, (height - 3) * image.width / image.height);
        const mobileWidth = Math.ceil(imageWidth * 7.2);
        const largeWidth = Math.ceil(imageWidth * 16.8);

        return (
          <li class="piece" style={`--x:${x};--y:${y};--w:${width};--h:${height};--tilt:${tilt}deg;--label-x:${labelX - x};--label-y:${labelY - y}`}>
            <a class="piece-link" href={href} aria-label={name} data-description={text} draggable="false">
              <Image
                src={image}
                alt=""
                format="webp"
                quality={74}
                widths={[256, 384, 512, 640, 800, 1024, 1200].filter((width) => width <= image.width)}
                sizes={`(max-width: 720px) ${mobileWidth}px, (max-width: 1680px) ${imageWidth.toFixed(2)}vw, ${largeWidth}px`}
                width={Math.min(image.width, 1200)}
                loading="lazy"
                draggable="false"
              />
            </a>
            <span class="piece-label" aria-hidden="true">{name}</span>
          </li>
        );
      })}
    </ul>
  </div>

  <dialog class="product-dialog" aria-labelledby="showcase-product-title" data-product-dialog>
    <div class="product-card">
      <form method="dialog">
        <button class="product-close" aria-label="Закрыть" autofocus>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"/>
          </svg>
        </button>
      </form>
      <img class="product-image" alt="" width="400" height="400" />
      <div class="product-info">
        <h3 id="showcase-product-title"></h3>
        <p></p>
        <div class="product-actions">
          <button type="button" data-order="" data-order-product>Сделать заказ</button>
          <a href="/pechat-na-futbolkah">Подробнее <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  import '@/scripts/print-showcase';
  import '@/scripts/showcase-motion';
</script>

<style>
  @font-face {
    font-family: 'Caveat';
    src: url('/fonts/merch/caveat-700-cyrillic.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }

  @font-face {
    font-family: 'Caveat';
    src: url('/fonts/merch/caveat-700-latin.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
    unicode-range: U+0000-00FF, U+2000-206F, U+2191, U+2193, U+2212, U+2215;
  }

  .series {
    --edge: clamp(1.125rem, 4.2cqi, 4.75rem);
    max-width: 105rem;
    margin-inline: auto;
    color: var(--merch-ink);
    container-type: inline-size;
  }

  .series-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .5rem 2rem;
    padding: clamp(1.5rem, 3.5cqi, 3.5rem) var(--edge) .75rem;
  }

  .series-intro h2 {
    font-size: clamp(2.25rem, 5.8cqi, 5.1rem);
    font-weight: 740;
    line-height: 1.04;
    letter-spacing: -.05em;
  }

  .series-intro p {
    color: var(--merch-muted);
    font-size: clamp(.875rem, 1.35cqi, 1.075rem);
  }

  .showcase {
    --unit: max(7.2px, 1cqi);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .showcase::-webkit-scrollbar {
    display: none;
  }

  .showcase-canvas {
    --top-space: 5.5;
    position: relative;
    width: calc(var(--canvas-width) * var(--unit));
    height: calc((54 + var(--top-space)) * var(--unit) + 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .print-mark {
    position: absolute;
    inset-inline-start: calc((var(--x) - var(--mark-size) / 2) * var(--unit));
    inset-block-start: calc((var(--y) + var(--top-space) - var(--mark-size) / 2) * var(--unit));
    width: calc(var(--mark-size) * var(--unit));
    aspect-ratio: 1;
    color: #cecec4;
    pointer-events: none;
  }

  .print-mark--accent {
    color: #a8c644;
  }

  .print-mark span {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat,
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat;
  }

  .print-mark--ring span::after {
    position: absolute;
    inset: 23%;
    border: 1px solid currentColor;
    border-radius: 50%;
    content: '';
  }

  .piece {
    position: absolute;
    inset-inline-start: calc(var(--x) * var(--unit));
    inset-block-start: calc((var(--y) + var(--top-space)) * var(--unit));
    display: grid;
    place-items: center;
    width: calc(var(--w) * var(--unit));
    height: calc(var(--h) * var(--unit));
    pointer-events: none;
  }

  .piece:has(.piece-link:is(:hover, :focus-visible)) {
    z-index: 1;
  }

  .piece-link {
    position: relative;
    display: grid;
    place-items: center;
    max-width: 100%;
    border-radius: .85rem;
    color: inherit;
    text-decoration: none;
    pointer-events: auto;
  }

  .piece-link img {
    display: block;
    width: auto;
    height: auto;
    max-width: calc(var(--w) * var(--unit));
    max-height: calc((var(--h) - 3) * var(--unit));
    filter: drop-shadow(0 .65rem .58rem rgb(16 16 16 / .17));
    transform: rotate(var(--tilt));
    transition: transform 220ms var(--ease-out);
  }

  .piece-label {
    position: absolute;
    z-index: 1;
    inset: calc(var(--label-y) * var(--unit)) auto auto calc(var(--label-x) * var(--unit));
    translate: -50% -50%;
    rotate: calc(var(--tilt) * .55);
    inline-size: max-content;
    max-inline-size: calc(25 * var(--unit));
    padding: .1em .24em;
    border-radius: .28rem;
    background: var(--merch-paper);
    font-family: 'Caveat', var(--font);
    font-size: clamp(1.125rem, calc(2.15 * var(--unit)), 2rem);
    font-weight: 700;
    line-height: .98;
    text-align: center;
  }

  .piece-label::after {
    content: '';
    display: block;
    width: 1.7rem;
    height: .35rem;
    margin-top: .15em;
    margin-inline: auto;
    border-top: 2px solid var(--merch-lime);
    border-radius: 50%;
    transform: rotate(-8deg);
    transform-origin: left;
  }

  @media (pointer: coarse) {
    .showcase {
      scroll-snap-type: x proximity;
    }

    .piece {
      scroll-snap-align: start;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .showcase,
    .piece-link {
      cursor: grab;
    }

    .showcase[data-dragging],
    .showcase[data-dragging] .piece-link {
      cursor: grabbing;
      scroll-snap-type: none;
    }

    .piece-label {
      opacity: 0;
      transform: translateY(.35rem);
      transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
    }

    .piece-label::after {
      transform: rotate(-8deg) scaleX(.12);
      transition: transform 280ms var(--ease-out);
    }

    .showcase:not([data-dragging]) .piece-link:hover + .piece-label,
    .piece-link:focus-visible + .piece-label {
      opacity: 1;
      transform: none;
    }

    .showcase:not([data-dragging]) .piece-link:hover + .piece-label::after,
    .piece-link:focus-visible + .piece-label::after {
      transform: rotate(-8deg);
    }

    .showcase:not([data-dragging]) .piece-link:hover img {
      transform: translateY(-.25rem) rotate(var(--tilt, -4deg));
    }
  }

  :global(html:has(.product-dialog[open])) {
    overflow: hidden;
  }

  .product-dialog {
    position: fixed;
    width: min(43rem, calc(100vw - 2rem));
    max-height: 92dvh;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 1.5rem;
    background: #fff;
    color: var(--merch-ink);
    box-shadow: 0 1rem 4rem rgb(0 0 0 / .2);
    transition: opacity 180ms var(--ease-out), transform 220ms var(--ease-out);
  }

  .product-dialog::backdrop {
    background: rgb(16 16 16 / .48);
  }

  .product-dialog:not([open]) {
    opacity: 0;
    transform: translateY(.6rem);
    pointer-events: none;
  }

  @supports (overlay: auto) {
    .product-dialog {
      transition-property: opacity, transform, display, overlay;
      transition-behavior: allow-discrete;
    }
  }

  @starting-style {
    .product-dialog[open] {
      opacity: 0;
      transform: translateY(.6rem);
    }
  }

  .product-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 1.5rem;
    padding: 2.25rem 1.5rem 1.5rem;
  }

  .product-card > form {
    position: absolute;
    z-index: 1;
    top: .65rem;
    right: .65rem;
  }

  .product-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--sky);
  }

  .product-close:hover {
    background: var(--merch-lime);
  }

  .product-image {
    width: 100%;
    height: clamp(11rem, 28vw, 18rem);
    object-fit: contain;
    filter: drop-shadow(0 .55rem .5rem rgb(16 16 16 / .14));
  }

  .product-info h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .product-info p {
    margin: .65rem 0 1.1rem;
    color: var(--merch-muted);
    line-height: 1.45;
  }

  .product-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .product-actions :is(a, button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    min-height: 46px;
    padding: .5rem .85rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: #fff;
    color: inherit;
    font-size: .9375rem;
    font-weight: 650;
    text-decoration: none;
  }

  .product-actions button {
    border-color: var(--merch-lime);
    background: var(--merch-lime);
  }

  .product-actions :is(a, button):hover {
    border-color: var(--merch-ink);
  }

  @media (max-width: 35rem) {
    .product-dialog {
      width: 100%;
      max-width: none;
      margin: auto 0 0;
      border-radius: 1.5rem 1.5rem 0 0;
    }

    .product-card {
      grid-template-columns: 1fr;
      gap: .65rem;
      padding: .875rem 1.125rem calc(1.25rem + env(safe-area-inset-bottom));
    }

    .product-image { height: min(12rem, 33dvh); }

    .product-actions > * { flex: 1 1 auto; }

    .product-dialog:not([open]) { transform: translateY(1.25rem); }

    @starting-style {
      .product-dialog[open] { transform: translateY(1.25rem); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-dialog,
    .piece-link img,
    .piece-label,
    .piece-label::after {
      transition: none;
    }
  }
</style>
