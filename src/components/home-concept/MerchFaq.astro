---
import { merchFaq } from '@/data/merch-faq';
import { site } from '@/data/site';

const mainQuestions = merchFaq.slice(0, 6);
const orderQuestions = merchFaq.slice(6);
---

<section class="merch-faq" id="faq" aria-labelledby="merch-faq-title">
  <div class="faq-inner">
    <div class="faq-intro">
      <h2 class="merch-section-title faq-title" id="merch-faq-title">
        <span>Частые</span>
        <span>вопросы</span>
      </h2>
      <p class="faq-lead">
        Печатаем на заказ в Калининграде с {site.founded} года. В ТЦ «Экватор» можно заказать одну кружку в подарок или тираж мерча для команды.
      </p>
      <a class="faq-about" href="/o-nas">О мастерской <span aria-hidden="true">↗</span></a>
    </div>

    <div class="faq-list">
      {mainQuestions.map(({ q, a, links }, index) => (
        <details class="faq-item" name="merch-faq" open={index === 0}>
          <summary class="faq-question">
            {q}
            <span class="faq-sign" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer">
            <p>{a}</p>
            {links && (
              <ul class="faq-related" role="list">
                {links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
              </ul>
            )}
          </div>
        </details>
      ))}
      <details class="faq-item faq-extra">
        <summary class="faq-question">
          Ещё {orderQuestions.length} вопроса о заказе
          <span class="faq-sign" aria-hidden="true"></span>
        </summary>
        <div class="faq-extra-list">
          {orderQuestions.map(({ q, a }) => (
            <details class="faq-item" name="merch-faq-order">
              <summary class="faq-question">
                {q}
                <span class="faq-sign" aria-hidden="true"></span>
              </summary>
              <div class="faq-answer"><p>{a}</p></div>
            </details>
          ))}
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .merch-faq {
    background: var(--merch-paper);
    color: var(--merch-ink);
  }

  .faq-inner {
    display: grid;
    align-items: start;
    gap: clamp(1.65rem, 4.4vw, 5rem);
    max-width: 105rem;
    margin-inline: auto;
    padding: clamp(2.4rem, 5vw, 5rem) clamp(1.125rem, 3.5vw, 3.9rem);
    container-type: inline-size;
  }

  .merch-faq .faq-title {
    position: relative;
    width: fit-content;
    margin-bottom: clamp(1.4rem, 3.6cqi, 2.75rem);
    font-size: clamp(3.1rem, 8.2cqi, 7.35rem);
    text-transform: uppercase;
    transform: none;
  }

  .faq-title span {
    display: block;
    transform: skewX(-13deg);
    transform-origin: left bottom;
  }

  .faq-title::after {
    position: absolute;
    inset: calc(100% + .08em) 3% auto 3%;
    height: .19em;
    background: var(--merch-lime);
    clip-path: polygon(0 79%, 24% 47%, 54% 13%, 83% 5%, 100% 11%, 91% 27%, 96% 38%, 66% 43%, 72% 53%, 47% 49%, 23% 74%, 2% 100%);
    content: '';
  }

  .faq-lead {
    max-width: 33ch;
    font-size: clamp(1rem, 1.55cqi, 1.28rem);
    line-height: 1.5;
  }

  .faq-related {
    display: flex;
    flex-wrap: wrap;
    gap: 0 .9rem;
  }

  .faq-about {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    min-height: 44px;
    margin-top: .5rem;
    font-weight: 650;
  }

  .faq-about,
  .faq-related a {
    text-underline-offset: .2em;
  }

  .faq-about:hover,
  .faq-related a:hover {
    text-decoration-thickness: 2px;
  }

  .faq-list {
    --faq-rule: #858580;
    border-top: 1px solid var(--faq-rule);
  }

  .faq-item {
    border-bottom: 1px solid var(--faq-rule);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
    padding-block: .8rem;
    font-size: clamp(1.05rem, 1.95cqi, 1.65rem);
    font-weight: 740;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    content: '';
  }

  .faq-sign {
    display: grid;
    flex: 0 0 1.625rem;
    place-items: center;
    width: 1.625rem;
    aspect-ratio: 1;
  }

  .faq-sign::before,
  .faq-sign::after {
    grid-area: 1 / 1;
    width: .95rem;
    height: 2px;
    background: currentColor;
    content: '';
  }

  .faq-sign::after {
    transform: rotate(90deg);
  }

  .faq-item[open] > .faq-question .faq-sign::after {
    display: none;
  }

  .faq-answer {
    max-width: 64ch;
    padding: 0 1.5rem 1rem 0;
    font-size: clamp(.95rem, 1.27cqi, 1.075rem);
    line-height: 1.55;
  }

  .faq-related {
    margin-top: .55rem;
    gap: .3rem .85rem;
  }

  .faq-extra-list {
    margin: 0 0 1rem 1rem;
    border-left: 1px solid var(--line);
    padding-left: 1rem;
  }

  @media (min-width: 761px) {
    .faq-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    }
  }
</style>
