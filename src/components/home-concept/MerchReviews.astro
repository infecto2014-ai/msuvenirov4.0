---
import Icon from '@/components/ui/Icon.astro';
import { homeReviews } from '@/data/home';
import { site } from '@/data/site';

const yandex = site.ratings.find(({ platform }) => platform === 'Яндекс Карты')!;
---

<section class="merch-reviews" id="otzyvy" aria-labelledby="merch-reviews-title" data-merch-reviews>
  <header class="reviews-heading">
    <h2 class="merch-section-title" id="merch-reviews-title">Отзывы клиентов</h2>
    <a class="reviews-rating" href={yandex.href} target="_blank" rel="noopener noreferrer">
      <span class="rating-score">
        <strong>{yandex.rating.toFixed(1).replace('.', ',')}</strong>
        <span class="rating-stars" aria-hidden="true">
          {Array.from({ length: 5 }, () => <Icon name="star" size={23} />)}
        </span>
      </span>
      <span>Яндекс Карты · {yandex.count} {yandex.unit}<span aria-hidden="true"> ↗</span></span>
    </a>
  </header>

  <div class="reviews-carousel">
    <button class="reviews-prev" type="button" aria-label="Предыдущие отзывы" aria-controls="merch-review-track" data-review-prev hidden>
      <Icon name="chevron-left" size={23} />
    </button>
    <ul class="reviews-track" id="merch-review-track" aria-label="Отзывы клиентов" data-review-track>
      {homeReviews.map((review, index) => {
        const source = site.ratings.find(({ platform }) => platform === review.source);
        return (
          <li class="review-card" data-review-card>
            <span class="review-mark" aria-hidden="true">“</span>
            <div class="review-copy">
              <blockquote class="review-quote"><p data-review-text>{review.text}</p></blockquote>
              <a class="review-more" href="/otzyvy" data-review-more={index}>
                Читать далее <span aria-hidden="true">↗</span>
                <span class="visually-hidden"> — отзыв {review.name}</span>
              </a>
            </div>
            <footer class="review-meta">
              <div class="review-author">
                <span class="review-avatar" aria-hidden="true">{review.name.charAt(0)}</span>
                <div>
                  <strong data-review-name>{review.name}</strong>
                  <span class="review-date" data-review-meta>{[review.source, review.date].filter(Boolean).join(' · ')}</span>
                </div>
              </div>
              {review.rating && <span class="review-score"><Icon name="star" size={14} /> {review.rating} из 5</span>}
              {source && (
                <a class="review-source" href={source.href} target="_blank" rel="noopener noreferrer" data-review-source>
                  Отзывы на площадке <span aria-hidden="true">↗</span>
                </a>
              )}
            </footer>
          </li>
        );
      })}
    </ul>
    <button class="reviews-next" type="button" aria-label="Следующие отзывы" aria-controls="merch-review-track" data-review-next hidden>
      <Icon name="chevron-right" size={23} />
    </button>
  </div>

  <div class="reviews-footer">
    <button class="reviews-play" type="button" data-review-play hidden>Приостановить</button>
    <a href="/otzyvy">Все отзывы <span aria-hidden="true">↗</span></a>
  </div>

  <dialog class="merch-review-dialog" aria-labelledby="merch-review-author" data-merch-review-dialog>
    <form method="dialog"><button type="submit" aria-label="Закрыть отзыв"><Icon name="x" size={22} /></button></form>
    <span class="review-mark" aria-hidden="true">“</span>
    <blockquote class="review-quote"><p data-dialog-review-text></p></blockquote>
    <footer class="review-meta">
      <strong id="merch-review-author"></strong>
      <span class="review-date" data-dialog-review-meta></span>
      <a class="review-source" target="_blank" rel="noopener noreferrer" data-dialog-review-source>
        Отзывы на площадке <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </dialog>
</section>

<script>
  import '@/scripts/merch-reviews';
</script>

<style>
  .merch-reviews {
    --review-gap: clamp(.85rem, 2vw, 1.35rem);
    max-width: 105rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 6rem) clamp(1.125rem, 4.2vw, 4rem) clamp(2rem, 5vw, 5rem);
    text-align: center;
    color: var(--merch-ink);
    container-type: inline-size;
  }

  .reviews-rating {
    display: inline-grid;
    justify-items: center;
    gap: .25rem;
    margin-top: clamp(1rem, 3cqi, 2rem);
    color: var(--merch-muted);
    text-decoration: none;
    font-size: .9rem;
  }

  .reviews-rating:hover,
  .reviews-footer a:hover,
  .review-source:hover,
  .review-more:hover {
    text-decoration: underline;
    text-underline-offset: .18em;
  }

  .rating-score,
  .rating-stars,
  .review-score {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    color: var(--merch-ink);
  }

  .rating-score { gap: .8rem; }
  .rating-score strong { font-size: clamp(2rem, 5cqi, 3rem); line-height: 1; }
  .rating-stars :global(svg),
  .review-score :global(svg) { fill: var(--merch-lime); stroke-width: 1.5; }

  .reviews-carousel {
    position: relative;
    max-width: 46rem;
    margin: clamp(1.25rem, 3cqi, 2.25rem) auto 0;
  }

  .reviews-track {
    position: relative;
    display: flex;
    gap: var(--review-gap);
    margin: 0;
    padding: .4rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: .4rem;
    scrollbar-width: none;
    list-style: none;
  }

  .reviews-track::-webkit-scrollbar { display: none; }

  .review-card {
    flex: 0 0 calc((100% - var(--review-gap)) / 2);
    min-width: 0;
    aspect-ratio: 1;
    display: grid;
    align-content: stretch;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: .72rem;
    padding: clamp(.9rem, 2.8cqi, 1.5rem);
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid var(--line);
    text-align: start;
  }

  .review-mark {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    background: var(--merch-lime);
    color: var(--merch-ink);
    font-family: 'Caveat', var(--font);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    overflow: hidden;
  }

  .review-copy {
    display: flex;
    flex-direction: column;
    min-height: 0;
    align-items: start;
  }

  .review-quote {
    margin: 0;
    font-family: 'Caveat', var(--font);
    font-size: clamp(1.27rem, 2.35cqi, 1.72rem);
    font-weight: 700;
    line-height: 1.07;
    overflow-wrap: anywhere;
  }

  .review-card .review-quote {
    min-height: 0;
    max-height: calc(100% - 1.65rem);
    overflow: hidden;
  }

  .review-card .review-quote p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    overflow: hidden;
  }

  .review-more {
    display: inline-flex;
    align-items: center;
    gap: .32rem;
    margin-top: .32rem;
    font-size: .8375rem;
    line-height: 1.25;
    color: inherit;
    font-weight: 650;
    text-decoration: none;
  }

  .review-meta {
    display: grid;
    gap: .28rem;
    padding-top: .66rem;
    border-top: 1px solid var(--line);
    text-align: start;
    font-size: .8125rem;
    line-height: 1.25;
  }

  .review-author {
    display: flex;
    align-items: center;
    gap: .55rem;
  }

  .review-avatar {
    flex: none;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--sky);
    font-weight: 750;
  }

  .review-date {
    display: block;
    color: var(--merch-muted);
    font-size: .75rem;
  }

  .review-source {
    color: var(--merch-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .reviews-prev,
  .reviews-next,
  .merch-review-dialog button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #fff;
    color: var(--merch-ink);
  }

  .reviews-prev,
  .reviews-next {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
  }

  .reviews-prev { right: calc(100% + .65rem); }
  .reviews-next { left: calc(100% + .65rem); }

  .reviews-prev:hover,
  .reviews-next:hover,
  .merch-review-dialog button:hover { background: var(--merch-lime); }

  .reviews-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: .2rem 1.25rem;
    margin-top: .8rem;
  }

  .reviews-play,
  .reviews-footer a {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--merch-ink);
    text-decoration: none;
    font-size: .9rem;
  }

  .reviews-play { color: var(--merch-muted); }
  .reviews-play:hover { text-decoration: underline; }

  .merch-reviews [hidden] { display: none; }

  :global(html:has(.merch-review-dialog[open])) { overflow: hidden; }

  .merch-review-dialog {
    width: min(34rem, calc(100vw - 1.5rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 0;
    background: #fff;
    color: var(--merch-ink);
    text-align: start;
  }

  .merch-review-dialog::backdrop { background: rgb(16 16 16 / .56); }
  .merch-review-dialog form { position: absolute; top: .7rem; right: .7rem; }
  .merch-review-dialog .review-quote { margin: 1rem 0; }

  @media (max-width: 59rem) {
    .reviews-carousel {
      display: grid;
      grid-template-columns: 1fr 1fr;
      justify-items: center;
      column-gap: .65rem;
    }

    .reviews-track { grid-area: 1 / 1 / 2 / 3; width: 100%; }
    .reviews-prev, .reviews-next { position: static; translate: none; margin-top: .55rem; }
    .reviews-prev { grid-area: 2 / 1; justify-self: end; }
    .reviews-next { grid-area: 2 / 2; justify-self: start; }
  }

  @media (max-width: 42rem) {
    .reviews-track { max-width: 24rem; }
    .review-card { flex-basis: 100%; }
  }
</style>
