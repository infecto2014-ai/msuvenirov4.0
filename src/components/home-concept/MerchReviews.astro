---
import { homeReviews } from '@/data/home';
import { site } from '@/data/site';

const stories = [
  { review: homeReviews[0], label: 'Очень быстрая и качественная печать…', original: `${site.twoGis}/review/312030839` },
  { review: homeReviews[1], label: 'Обратились по срочному заказу…', excerpt: 'Обратились по срочному заказу — печать на футболках.' },
  {
    review: homeReviews[2],
    label: 'Сделали за час',
    excerpt: 'Заказывала печать на футболке, сделали за час.',
    original: `${site.yandexMapsOrg}/reviews/?reviews%5BpublicId%5D=874n9648wbkpjnk1nm1736v0fr`,
  },
  { review: homeReviews[4], label: 'Распечатка заняла 5 минут', excerpt: '…и потом распечатка заняла 5 минут.' },
].map(story => ({
  ...story,
  sourceLink: story.original ?? site.ratings.find(rating => rating.platform === story.review.source)?.href,
  sourceLabel: story.original ? 'Оригинал' : 'На площадке',
}));
---

<section class="merch-reviews" id="otzyvy" aria-labelledby="merch-reviews-title" data-merch-reviews>
  <div class="reviews-inner">
    <header class="reviews-heading">
      <h2 class="merch-section-title" id="merch-reviews-title">Отзывы клиентов</h2>
      <a class="reviews-all" href="/otzyvy">Все отзывы <span aria-hidden="true">↗</span></a>
    </header>

    <div class="reviews-desktop">
      <div class="review-tabs" role="tablist" aria-label="Истории клиентов" aria-orientation="vertical">
        <span class="review-marker" data-review-marker aria-hidden="true"></span>
        {stories.map(({ review, label }, index) => (
          <button
            class="review-tab"
            type="button"
            role="tab"
            id={`review-tab-${index}`}
            aria-controls={`review-panel-${index}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            <strong>{label}</strong>
            <span>{review.name}</span>
          </button>
        ))}
      </div>

      <span class="review-quotation" aria-hidden="true">“</span>
      {stories.map(({ review, excerpt, sourceLink, sourceLabel }, index) => (
        <div
          class="review-panel"
          id={`review-panel-${index}`}
          role="tabpanel"
          tabindex="0"
          aria-labelledby={`review-tab-${index}`}
          aria-hidden={index === 0 ? undefined : 'true'}
          data-selected={index === 0 ? 'true' : 'false'}
          inert={index !== 0}
        >
          <blockquote class="review-quote"><p>{excerpt ?? review.text}</p></blockquote>
          <div class="review-meta">
            <span>{review.name} · {review.source}</span>
            {sourceLink && (
              <a href={sourceLink} target="_blank" rel="noopener noreferrer">
                {sourceLabel} <span aria-hidden="true">↗</span>
                <span class="visually-hidden"> ({review.source}, новая вкладка)</span>
              </a>
            )}
            {excerpt && <button type="button" class="review-more" data-review-more={index}>Читать целиком</button>}
          </div>
        </div>
      ))}
    </div>

    <div class="reviews-accordion">
      {stories.map(({ review, label, sourceLink, sourceLabel }, index) => (
        <details class="review-story" name="review-story" open={index === 0}>
          <summary>
            <span>{label}</span>
            <span class="review-sign" aria-hidden="true"></span>
          </summary>
          <blockquote class="review-story-text"><p>{review.text}</p></blockquote>
          <div class="review-meta">
            <span>{review.name} · {review.source}</span>
            {sourceLink && (
              <a href={sourceLink} target="_blank" rel="noopener noreferrer">
                {sourceLabel} <span aria-hidden="true">↗</span>
                <span class="visually-hidden"> ({review.source}, новая вкладка)</span>
              </a>
            )}
          </div>
        </details>
      ))}
    </div>

    <ul class="reviews-ratings" role="list" aria-label="Оценки на площадках">
      {site.ratings.map(({ href, platform, rating }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer">
            {platform} <span class="rating-score">{rating.toFixed(1).replace('.', ',')} <span aria-hidden="true">↗</span></span>
            <span class="visually-hidden"> (новая вкладка)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="merch-review-dialog" aria-labelledby="merch-review-author" data-merch-review-dialog>
    <div class="review-dialog-head">
      <h3 id="merch-review-author"></h3>
      <form method="dialog"><button type="submit" aria-label="Закрыть отзыв" autofocus>×</button></form>
    </div>
    <blockquote><p data-dialog-review-text></p></blockquote>
  </dialog>
</section>

<script>
  import '@/scripts/merch-reviews';
</script>

<style>
  .merch-reviews {
    background: #faf7f0;
    color: var(--merch-ink);
  }

  .reviews-inner {
    max-width: 105rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 5rem) clamp(1.125rem, 3.5vw, 3.9rem);
    container-type: inline-size;
  }

  .reviews-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    column-gap: 1.5rem;
    padding-bottom: clamp(.55rem, 1.8cqi, 1.4rem);
    border-bottom: 1.5px solid currentColor;
  }

  .reviews-heading .merch-section-title {
    font-size: clamp(2.35rem, 5.9cqi, 6rem);
    text-transform: uppercase;
  }

  .reviews-all {
    display: inline-flex;
    align-items: center;
    gap: .4em;
    min-height: 44px;
    font-size: clamp(1rem, 1.95cqi, 1.65rem);
    font-weight: 550;
    text-decoration: none;
  }

  .reviews-all:hover {
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .reviews-desktop {
    display: none;
  }

  .review-story + .review-story {
    border-top: 1px solid #858580;
  }

  .review-story summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .85rem;
    min-height: 56px;
    padding: .95rem 0;
    font-size: clamp(1.0625rem, 3.3cqi, 1.5rem);
    font-weight: 750;
    line-height: 1.25;
    list-style: none;
    cursor: pointer;
  }

  .review-story summary::-webkit-details-marker {
    display: none;
  }

  .review-sign {
    display: grid;
    flex: 0 0 1.25rem;
    place-items: center;
  }

  .review-sign::before,
  .review-sign::after {
    grid-area: 1 / 1;
    width: .9rem;
    height: 2px;
    background: currentColor;
    content: '';
  }

  .review-sign::after { transform: rotate(90deg); }
  .review-story[open] .review-sign::after { display: none; }

  .review-story[open] summary span:first-child {
    border-inline-start: .275rem solid var(--merch-lime);
    padding-inline-start: .65rem;
  }

  .review-story-text {
    font-size: clamp(1rem, 2.6cqi, 1.25rem);
    line-height: 1.48;
  }

  .review-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 clamp(.8rem, 2.3cqi, 2rem);
    margin-block: .55rem .5rem;
    font-size: clamp(.9rem, 1.55cqi, 1.4rem);
    line-height: 1.35;
  }

  .review-meta a,
  .review-more,
  .reviews-ratings a {
    display: inline-flex;
    align-items: center;
    gap: .28em;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .review-more {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }

  .reviews-ratings {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 .55rem;
    padding-block-start: clamp(.35rem, 1.5cqi, 1.15rem);
    border-top: 1.5px solid currentColor;
  }

  .reviews-ratings a {
    font-size: clamp(.8rem, 1.92cqi, 1.65rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .rating-score { white-space: nowrap; }

  :global(html:has(.merch-review-dialog[open])) { overflow: hidden; }

  .merch-review-dialog {
    width: min(38rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 0;
    background: var(--merch-paper);
    color: var(--merch-ink);
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  .merch-review-dialog::backdrop { background: rgb(16 16 16 / .56); }

  .review-dialog-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .review-dialog-head h3 { text-wrap: wrap; }

  .review-dialog-head button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #fff;
    font-size: 1.5rem;
  }

  .review-dialog-head button:hover { background: var(--merch-lime); }

  @media (min-width: 50rem) {
    .merch-reviews[data-review-tabs-ready] .reviews-accordion { display: none; }

    .merch-reviews[data-review-tabs-ready] .reviews-desktop {
      display: grid;
      grid-template-columns: minmax(0, 1.72fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: clamp(2.2rem, 5cqi, 5rem);
      row-gap: .3rem;
      padding-block: clamp(1.5rem, 3.25cqi, 3.25rem);
    }

    .review-quotation {
      grid-area: 1 / 1;
      height: .57em;
      color: var(--merch-lime);
      font-family: var(--font);
      font-size: clamp(5.5rem, 10.8cqi, 11rem);
      font-weight: 900;
      line-height: 1;
      transform: skewX(-12deg);
      transform-origin: left top;
      user-select: none;
    }

    .review-tabs {
      position: relative;
      grid-area: 1 / 2 / span 2;
      align-self: start;
    }

    .review-tab {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: .4em;
      width: 100%;
      min-height: 44px;
      padding: clamp(.8rem, 1.55cqi, 1.6rem) 0;
      border: 0;
      background: none;
      color: inherit;
      text-align: start;
      line-height: 1.22;
    }

    .review-tab + .review-tab { border-top: 1px solid #858580; }

    .review-tab strong {
      font-size: clamp(1.2rem, 2.05cqi, 2rem);
      font-weight: 800;
      letter-spacing: -.035em;
    }

    .review-tab > span { font-size: clamp(.98rem, 1.5cqi, 1.45rem); }

    .review-tab:hover strong {
      text-decoration: underline;
      text-underline-offset: .15em;
    }

    .review-marker {
      position: absolute;
      inset: 0 auto auto clamp(-1.25rem, -1.4cqi, -.65rem);
      width: clamp(.3rem, .5cqi, .5rem);
      height: 100px;
      background: var(--merch-lime);
      transform: scaleY(0);
      transform-origin: top;
      pointer-events: none;
    }

    .review-panel {
      grid-area: 2 / 1;
      align-self: start;
      min-width: 0;
      visibility: hidden;
      opacity: 0;
    }

    .review-panel[data-selected='true'] {
      visibility: visible;
      opacity: 1;
    }

    .review-quote {
      font-size: clamp(2.55rem, 5.85cqi, 6.15rem);
      font-weight: 750;
      line-height: 1.03;
      letter-spacing: -.057em;
      text-wrap: pretty;
    }

    .review-panel .review-meta { margin: clamp(1rem, 2cqi, 2rem) 0 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .merch-reviews[data-review-motion] .review-marker {
      transition: transform 220ms var(--ease);
    }

    .merch-reviews[data-review-motion] .review-panel {
      transition: opacity 180ms var(--ease-out), visibility 180ms step-end;
    }

    .merch-reviews[data-review-motion] .review-panel[data-selected='true'] {
      transition: opacity 220ms var(--ease-out);
    }

    .review-story[open]::details-content {
      animation: review-story-reveal 180ms var(--ease-out);
    }

    @keyframes review-story-reveal { from { opacity: 0; } }
  }
</style>
