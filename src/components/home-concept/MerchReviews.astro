---
import Icon from '@/components/ui/Icon.astro';
import { homeReviews } from '@/data/home';
import { site } from '@/data/site';
---

<section class="merch-reviews" id="otzyvy" aria-labelledby="merch-reviews-title" data-merch-reviews>
  <header class="reviews-heading">
    <h2 class="merch-section-title" id="merch-reviews-title">Отзывы <span>клиентов</span></h2>
    <a class="reviews-all" href="/otzyvy">Все отзывы <Icon name="arrow-right" size={20} /></a>
  </header>

  <ul class="reviews-ratings" role="list" aria-label="Оценки на площадках">
    {site.ratings.map((rating) => (
      <li>
        <a class="reviews-rating" href={rating.href} target="_blank" rel="noopener noreferrer">
          <span class="rating-score">
            <Icon name="star" size={25} />
            {rating.rating.toFixed(1).replace('.', ',')}
          </span>
          <span class="rating-meta">
            <strong>{rating.platform}</strong>
            <span>{rating.count} {rating.unit}</span>
            <span class="visually-hidden"> (новая вкладка)</span>
          </span>
          <Icon name="arrow-right" size={18} class="rating-arrow" />
        </a>
      </li>
    ))}
  </ul>

  <ul class="reviews-grid" role="list" aria-label="Отзывы клиентов">
    {homeReviews.map((review) => (
      <li class="review-card" data-review-card>
        {review.rating && <span class="review-score"><Icon name="star" size={18} /> {review.rating} из 5</span>}
        <div class="review-copy">
          <blockquote class="review-quote"><p data-review-text>{review.text}</p></blockquote>
          <a class="review-more" href="/otzyvy" data-review-more>
            Читать далее <span aria-hidden="true">↗</span>
            <span class="visually-hidden"> — отзыв {review.name}</span>
          </a>
        </div>
        <footer class="review-meta">
          <span class="review-avatar" aria-hidden="true">{review.name.charAt(0)}</span>
          <div>
            <strong data-review-name>{review.name}</strong>
            <span class="review-date" data-review-meta>{[review.source, review.date].filter(Boolean).join(' · ')}</span>
          </div>
        </footer>
      </li>
    ))}
  </ul>

  <dialog class="merch-review-dialog" aria-labelledby="merch-review-author" data-merch-review-dialog>
    <form method="dialog"><button type="submit" aria-label="Закрыть отзыв"><Icon name="x" size={22} /></button></form>
    <blockquote class="review-quote"><p data-dialog-review-text></p></blockquote>
    <footer class="review-meta">
      <div>
        <strong id="merch-review-author"></strong>
        <span class="review-date" data-dialog-review-meta></span>
      </div>
    </footer>
  </dialog>
</section>

<script>
  import '@/scripts/merch-reviews';
</script>

<style>
  .merch-reviews {
    --review-gap: clamp(.85rem, 1.6vw, 1.5rem);
    max-width: 105rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 5rem) clamp(1.125rem, 3.5vw, 3.9rem) clamp(2.5rem, 5vw, 5rem);
    color: var(--merch-ink);
    container-type: inline-size;
  }

  .reviews-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .7rem 1.4rem;
    margin-bottom: clamp(1.3rem, 3cqi, 2.3rem);
  }

  .reviews-heading h2 {
    font-size: clamp(2.25rem, 4.1cqi, 4rem);
  }

  .reviews-heading h2 span {
    position: relative;
    display: inline-block;
  }

  .reviews-heading h2 span::after {
    position: absolute;
    inset: calc(100% + .025em) .04em auto;
    height: .15em;
    background: var(--merch-lime);
    clip-path: polygon(0 66%, 39% 32%, 88% 0, 81% 32%, 67% 59%, 100% 45%, 98% 76%, 56% 92%, 61% 52%, 70% 33%, 30% 68%, 0 100%);
    content: '';
  }

  .reviews-all {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    min-height: 44px;
    color: inherit;
    font-weight: 650;
    white-space: nowrap;
    text-decoration: none;
  }

  .reviews-all:hover,
  .review-more:hover {
    text-decoration: underline;
    text-underline-offset: .18em;
  }

  .reviews-ratings,
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--review-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reviews-ratings {
    margin-bottom: clamp(1.55rem, 3cqi, 2.65rem);
  }

  .reviews-rating {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(.6rem, 1.35cqi, 1.15rem);
    min-height: clamp(66px, 6cqi, 86px);
    padding: .8rem clamp(.9rem, 2cqi, 1.65rem);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--sky-2);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--t-fast) ease, border-color var(--t-fast) ease;
  }

  .reviews-rating:hover {
    border-color: var(--merch-ink);
    background: #fff;
  }

  .rating-score,
  .review-score {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  .rating-score {
    font-size: clamp(1.55rem, 2.7cqi, 2.3rem);
    font-weight: 800;
    line-height: 1;
  }

  .rating-score :global(svg),
  .review-score :global(svg) {
    fill: var(--merch-lime);
    stroke-width: 1.4;
    flex: none;
  }

  .rating-meta {
    display: grid;
    flex: 1;
    min-width: 0;
    color: var(--merch-muted);
    font-size: .875rem;
    line-height: 1.28;
  }

  .rating-meta strong {
    color: var(--merch-ink);
    font-size: .98rem;
  }

  .reviews-rating :global(.rating-arrow) { flex: none; }

  .reviews-grid {
    padding-bottom: .65rem;
  }

  .review-card {
    position: relative;
    aspect-ratio: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: .65rem;
    padding: clamp(.9rem, 2cqi, 1.75rem);
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 .65rem 1.45rem rgb(16 16 16 / .05);
    transform: translateY(var(--drop, 0)) rotate(var(--tilt, 0deg));
    transition: transform 240ms var(--ease-out);
  }

  .review-card:nth-child(6n + 1) { --tilt: -1deg; }
  .review-card:nth-child(6n + 2) { --tilt: .8deg; --drop: 9px; }
  .review-card:nth-child(6n + 3) { --tilt: -.45deg; }
  .review-card:nth-child(6n + 4) { --tilt: .8deg; --drop: 9px; }
  .review-card:nth-child(6n + 5) { --tilt: -.65deg; }
  .review-card:nth-child(6n + 6) { --tilt: .45deg; --drop: 9px; }

  @media (hover: hover) {
    .review-card:hover { transform: translateY(var(--drop, 0)); }
  }

  .review-card:focus-within { transform: translateY(var(--drop, 0)); }

  .review-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: start;
    min-height: 0;
  }

  .review-quote {
    margin: 0;
    font-family: 'Caveat', var(--font);
    font-size: clamp(1.375rem, 2.35cqi, 1.95rem);
    font-weight: 700;
    line-height: 1.12;
    overflow-wrap: anywhere;
  }

  .review-card .review-quote {
    min-height: 0;
    max-height: calc(100% - 1.55rem);
    overflow: hidden;
  }

  .review-card .review-quote p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 7;
    line-clamp: 7;
    overflow: hidden;
  }

  .review-more {
    margin-top: .35rem;
    color: inherit;
    font-size: .825rem;
    line-height: 1.2;
    font-weight: 650;
    text-decoration: none;
  }

  .review-more[hidden] { display: none; }

  .review-meta {
    display: flex;
    align-items: center;
    gap: .7rem;
    padding-top: .8rem;
    border-top: 1px solid var(--line);
    font-size: .925rem;
    line-height: 1.35;
  }

  .review-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: clamp(2.25rem, 3.6cqi, 3rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sky);
    font-weight: 800;
  }

  .review-date {
    display: block;
    color: var(--merch-muted);
    font-size: .79rem;
  }

  :global(html:has(.merch-review-dialog[open])) { overflow: hidden; }

  .merch-review-dialog {
    width: min(34rem, calc(100vw - 1.5rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 0;
    background: #fff;
    color: var(--merch-ink);
  }

  .merch-review-dialog::backdrop { background: rgb(16 16 16 / .56); }
  .merch-review-dialog form { display: flex; justify-content: end; }
  .merch-review-dialog .review-quote { margin: .5rem 0 1.2rem; }

  .merch-review-dialog button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #fff;
  }

  .merch-review-dialog button:hover { background: var(--merch-lime); }

  @media (max-width: 68.75rem) {
    .reviews-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 56.25rem) {
    .reviews-ratings { grid-template-columns: minmax(0, 1fr); gap: .45rem; }
    .reviews-rating { min-height: 58px; }
    .review-card:nth-child(n) { --drop: 0px; --tilt: 0deg; }
  }

  @media (max-width: 35rem) {
    .reviews-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
