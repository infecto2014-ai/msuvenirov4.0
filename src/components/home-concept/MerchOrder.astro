---
import { orderSteps } from '@/data/merch-order';
---

<section class="order-guide" aria-labelledby="merch-order-title">
  <div class="order-inner">
    <div class="order-intro">
      <h2 class="merch-section-title order-title" id="merch-order-title">
        <span>Как</span>
        <span>заказать</span>
      </h2>

      <div class="order-actions">
        <a class="order-primary" href="#print-series">Выбрать изделие <span aria-hidden="true">↗</span></a>
        <button class="order-secondary" type="button" data-order="">
          <span>Отправить макет</span> <span aria-hidden="true">↗</span>
        </button>
      </div>
    </div>

    <ol class="order-sheet" role="list">
      {orderSteps.map(({ title, text }, index) => (
        <li class="order-step">
          <span class="step-number" aria-hidden="true">{index + 1}</span>
          <div class="step-copy">
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .order-guide {
    --order-edge: clamp(1.125rem, 3.5vw, 3.9rem);
    background: var(--merch-ink);
    color: var(--merch-paper);
  }

  .order-inner {
    display: grid;
    gap: clamp(1.65rem, 4.3vw, 4rem);
    width: min(97.2rem, calc(100% - 2 * var(--order-edge)));
    margin-inline: auto;
    padding-block: clamp(2.25rem, 4.7vw, 5rem);
    container-type: inline-size;
  }

  .order-guide .order-title {
    width: fit-content;
    font-size: clamp(3.65rem, 7.7cqi, 7.5rem);
    text-transform: uppercase;
    transform: none;
  }

  .order-title span {
    display: block;
    transform: skewX(-13deg);
    transform-origin: left bottom;
  }

  .order-actions {
    display: grid;
    justify-items: start;
    gap: .65rem;
    margin-block-start: clamp(1.35rem, 3.5cqi, 3.4rem);
  }

  .order-primary,
  .order-secondary {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 44px;
    font-size: clamp(1rem, 1.95cqi, 1.65rem);
    line-height: 1.2;
  }

  .order-primary {
    justify-content: center;
    min-height: 3.1rem;
    padding: .64rem clamp(1.15rem, 2.6cqi, 2.4rem);
    border-radius: 100vmax;
    background: var(--merch-lime);
    color: var(--merch-ink);
    font-weight: 750;
    text-decoration: none;
  }

  .order-primary:hover {
    background: #b9ed00;
  }

  .order-secondary {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .order-secondary span:first-child {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .3em;
  }

  .order-secondary:hover {
    color: var(--merch-lime);
  }

  .order-guide .order-actions :is(a, button):focus-visible {
    outline-color: var(--merch-lime);
  }

  .order-sheet {
    --hole-radius: clamp(.31rem, .63cqi, .54rem);
    --hole-step: calc(3.45 * var(--hole-radius));
    --hole-edge: calc(var(--hole-radius) + 1px);
    position: relative;
    isolation: isolate;
    margin: 0;
    padding: clamp(.7rem, 1.15cqi, 1rem) clamp(1rem, 2.9cqi, 2.55rem);
    list-style: none;
    color: var(--merch-ink);
  }

  .order-sheet::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--merch-paper);
    mask:
      linear-gradient(#000 0 0) center / calc(100% - 2 * var(--hole-radius)) 100% no-repeat,
      radial-gradient(circle at left, transparent calc(var(--hole-radius) - .5px), #000 var(--hole-radius))
        left top / var(--hole-edge) var(--hole-step) repeat-y,
      radial-gradient(circle at right, transparent calc(var(--hole-radius) - .5px), #000 var(--hole-radius))
        right top / var(--hole-edge) var(--hole-step) repeat-y;
    pointer-events: none;
    content: '';
  }

  .order-step {
    display: grid;
    grid-template-columns: clamp(1.8rem, 5.8cqi, 4.65rem) minmax(0, 1fr);
    gap: clamp(.68rem, 2.35cqi, 2rem);
    padding-block: clamp(.83rem, 1.6cqi, 1.45rem);
  }

  .order-step + .order-step {
    border-block-start: 1px solid var(--line);
  }

  .step-number {
    display: grid;
    place-items: center;
    border-inline-end: 1px solid var(--line);
    padding-inline-end: .25rem;
    font-family: 'Merch Oswald', var(--font);
    font-size: clamp(1.35rem, 3cqi, 2.65rem);
    font-style: italic;
    font-weight: 550;
    line-height: 1;
  }

  .step-copy h3 {
    margin: 0;
    font-family: 'Merch Oswald', var(--font);
    font-size: clamp(1.43rem, 3.1cqi, 2.8rem);
    font-weight: 700;
    line-height: 1.06;
    transform: skewX(-11deg);
    transform-origin: left 80%;
  }

  .step-copy p {
    margin: .38rem 0 0;
    font-size: clamp(.9375rem, 1.58cqi, 1.2rem);
    line-height: 1.38;
    text-wrap: pretty;
  }

  @media (min-width: 49rem) {
    .order-inner {
      grid-template-columns: minmax(0, .76fr) minmax(0, 1.24fr);
      align-items: start;
    }

    .order-intro {
      padding-block-start: clamp(1.25rem, 3.25cqi, 3rem);
    }
  }
</style>
